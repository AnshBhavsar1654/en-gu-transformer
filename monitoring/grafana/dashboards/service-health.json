{
  "uid": "en-gu-service",
  "title": "Service health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-2d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Translation requests and responses",
      "datasource": {
        "type": "prometheus",
        "uid": "en-gu-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(en_gu_http_requests_total{path=\"/translate\"}[5m]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "en-gu-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Translation latency",
      "datasource": {
        "type": "prometheus",
        "uid": "en-gu-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(en_gu_http_request_duration_seconds_bucket{path=\"/translate\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "en-gu-prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(en_gu_http_request_duration_seconds_bucket{path=\"/translate\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "en-gu-prometheus"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(en_gu_http_request_duration_seconds_bucket{path=\"/translate\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "en-gu-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Active HTTP requests",
      "datasource": {
        "type": "prometheus",
        "uid": "en-gu-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "en_gu_http_requests_in_progress",
          "legendFormat": "in flight",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "en-gu-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API process memory",
      "datasource": {
        "type": "prometheus",
        "uid": "en-gu-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "en_gu_process_resident_bytes",
          "legendFormat": "resident",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "en-gu-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API process CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "en-gu-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(en_gu_process_cpu_seconds_total[5m])",
          "legendFormat": "CPU cores used",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "en-gu-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Model load duration",
      "datasource": {
        "type": "prometheus",
        "uid": "en-gu-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "en_gu_model_load_seconds",
          "legendFormat": "seconds",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "en-gu-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Model startup attempts since last restart",
      "datasource": {
        "type": "prometheus",
        "uid": "en-gu-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "en_gu_model_load_attempts_total",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "en-gu-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Readiness and scrape health",
      "datasource": {
        "type": "prometheus",
        "uid": "en-gu-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "en_gu_model_ready",
          "legendFormat": "model ready",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "en-gu-prometheus"
          }
        },
        {
          "expr": "up{job=\"en-gu-api\"}",
          "legendFormat": "API scrape",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "en-gu-prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
